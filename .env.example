# Postgres connection. On Vercel + Supabase, set DATABASE_URL to the pooled
# (pgbouncer, port 6543) connection string, and DIRECT_URL to the direct
# (port 5432) connection string — Prisma needs the direct one to run
# migrations. If only POSTGRES_PRISMA_URL / POSTGRES_URL are set (e.g. by a
# Vercel Postgres/Supabase integration), the app falls back to those
# automatically — see lib/prisma.ts.
DATABASE_URL="postgresql://user:password@host:6543/xwallet?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/xwallet?schema=public"

# Session signing secret. Any one of these is accepted (lib/auth.ts checks
# JWT_SECRET first, then AUTH_SECRET, then NEXTAUTH_SECRET).
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: share the session cookie across the apex domain and www so
# clients aren't logged out switching between xwallet.asia and
# www.xwallet.asia. Leave unset for preview/*.vercel.app deployments.
# COOKIE_DOMAIN=".xwallet.asia"

# Optional: on boot, if no ADMIN user exists yet, automatically create one
# with these credentials (ACTIVE, role ADMIN). Set these in the Vercel
# dashboard only — never commit real values here. Leave both unset to fall
# back to "the first person to register becomes admin" instead.
# ADMIN_BOOTSTRAP_EMAIL="owner@xwallet.asia"
# ADMIN_BOOTSTRAP_PASSWORD="choose-a-strong-password"

# Transactional email (lib/email.ts), sent via Resend from
# "XWallet Asia <support@xwallet.asia>" — registration confirmation links,
# account-activation notices, and a notification for every deposit,
# withdrawal, transfer, and conversion. The xwallet.asia domain must be
# verified in the Resend dashboard (SPF/DKIM DNS records) before
# support@xwallet.asia can send. Without this key, emails are skipped (a
# warning is logged) rather than breaking the underlying action.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: overrides the base URL used to build links inside emails (e.g.
# the email-confirmation link). Defaults to Vercel's own production URL in
# production, or http://localhost:3000 locally — only needed if that
# default would be wrong for your setup.
# NEXT_PUBLIC_APP_URL="https://xwallet.asia"
