generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  MANUAL_CREDIT
  MANUAL_DEBIT
  TRANSFER_SENT
  TRANSFER_RECEIVED
  SWAP_DEBIT
  SWAP_CREDIT
}

enum TransactionStatus {
  PENDING
  // Withdrawal-only intermediate state: an admin has approved the request
  // and a multi-sig proposal payload has been queued (see
  // Transaction.multisigProposal), but no on-chain execution has been
  // confirmed yet. Every other transaction type goes straight from
  // PENDING to APPROVED/REJECTED and never passes through this state.
  QUEUED
  APPROVED
  REJECTED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum KycTier {
  BASIC
  VERIFIED
  INSTITUTIONAL
}

enum UnattributedDepositStatus {
  PENDING
  ASSIGNED
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  role         Role       @default(CLIENT)
  status       UserStatus @default(PENDING_APPROVAL)
  createdAt    DateTime   @default(now())

  // Self-service email confirmation: set on registration, cleared once the
  // client clicks their confirmation link (or once an admin approves them
  // manually — either path is valid, and whichever happens first wins).
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  // TOTP is mandatory for ADMIN accounts. The secret is generated on first
  // login and stored encrypted at rest (see lib/crypto.ts) — totpEnabled
  // only flips true once the admin has proven possession by entering a
  // valid code, so a secret existing alone never grants access.
  totpSecretEncrypted String?
  totpEnabled         Boolean @default(false)
  // Single-use recovery codes issued once at enrollment, stored as bcrypt
  // hashes (never plaintext) — each is removed from the array the moment
  // it's consumed, so a leaked hash can't be replayed after the fact.
  totpBackupCodesHash String[] @default([])

  // KYC tiering: BASIC is the default for every new account and carries no
  // limits unless an admin sets one. Limits are opt-in (null = unlimited)
  // so existing accounts are unaffected until an admin explicitly tightens
  // them — see requireFreshClientSession()/checkTransactionLimits().
  kycTier         KycTier  @default(BASIC)
  dailyLimitUsd   Decimal? @db.Decimal(24, 2)
  monthlyLimitUsd Decimal? @db.Decimal(24, 2)

  balances         UserBalance[]
  transactions     Transaction[]
  sessions         Session[]
  assignedDeposits UnattributedDeposit[]
}

// A cold-storage / multi-sig custody wallet the platform actually holds
// funds in, tracked here as a scaffold for institutional custody. This is
// deliberately not wired to a live signer (Safe Transaction Service, an
// MPC provider's API, ...) — reserves are recorded by an admin via
// VaultReserve as an as-of snapshot, not read on-chain in real time.
model CustodyVault {
  id           String         @id @default(cuid())
  name         String
  provider     String // "GNOSIS_SAFE" | "MPC_FIREBLOCKS" | ...
  chainId      Int
  vaultAddress String
  threshold    Int
  signers      String[]
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  reserves     VaultReserve[]
}

// An admin-recorded snapshot of one vault's balance in one asset, used by
// the Proof-of-Reserve dashboard (/admin/reserves) as the "reserves" side
// of the solvency comparison against total client liabilities.
model VaultReserve {
  id        String       @id @default(cuid())
  vaultId   String
  vault     CustodyVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset        @relation(fields: [assetId], references: [id])
  balance   Decimal      @db.Decimal(24, 8)
  updatedAt DateTime     @updatedAt

  @@unique([vaultId, assetId])
}

// One row per issued session cookie, so a session can be identified,
// audited, and force-revoked independently of the others — the JWT itself
// carries this row's id as its `jti` claim. tokenHash is a SHA-256 digest
// of the signed JWT (never the token itself), kept for audit/lookup
// without storing anything that could itself be replayed as a credential.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model Asset {
  id       String  @id @default(cuid())
  symbol   String  @unique
  name     String
  logoUrl  String?
  isActive Boolean @default(true)

  networkAddresses     NetworkAddress[]
  balances             UserBalance[]
  transactions         Transaction[]
  feeTransactions      Transaction[]         @relation("TransactionFeeAsset")
  unattributedDeposits UnattributedDeposit[]
  vaultReserves        VaultReserve[]
  ledgerEntries        LedgerEntry[]
}

model NetworkAddress {
  id            String  @id @default(cuid())
  assetId       String
  asset         Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  networkName   String
  walletAddress String
  isActive      Boolean @default(true)

  @@unique([assetId, networkName])
}

model UserBalance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  balance     Decimal  @default(0) @db.Decimal(24, 8)
  lastUpdated DateTime @updatedAt

  @@unique([userId, assetId])
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  networkName       String?
  type              TransactionType
  amount            Decimal           @db.Decimal(24, 8)
  feeAmount         Decimal?          @db.Decimal(24, 8)
  feeAssetId        String?
  feeAsset          Asset?            @relation("TransactionFeeAsset", fields: [feeAssetId], references: [id])
  counterpartyEmail String?
  destinationAddress String?
  // Unique (not just indexed) so the same on-chain deposit can never be
  // credited twice — Postgres unique indexes permit any number of NULLs,
  // so transfers/swaps/manual adjustments (which never set a txHash) are
  // unaffected. submitDeposit() also pre-checks this for a friendly error
  // message; this constraint is the hard backstop against the same race
  // that pattern is otherwise vulnerable to.
  txHash            String?           @unique
  status            TransactionStatus @default(PENDING)
  referenceNote     String?
  createdAt         DateTime          @default(now())

  // Multi-sig withdrawal workflow: populated when a WITHDRAWAL moves from
  // PENDING to QUEUED (see reviewWithdrawal) — the parameters an off-chain
  // Safe/MPC signing process needs (destination, value, asset, chain,
  // vault, threshold/signers at proposal time). Never populated for any
  // other transaction type.
  multisigProposal Json?

  // Advisory-only transaction-monitoring flag (lib/velocity.ts) — set at
  // creation time for TRANSFER_SENT/WITHDRAWAL rows that look anomalous
  // against the sending user's own history. Never blocks the transaction,
  // only surfaces it for admin review (ANOMALY_REVIEW tag on
  // /admin/transactions).
  flaggedForReview Boolean @default(false)
  flagReason       String?

  ledgerEntries LedgerEntry[]
}

// Immutable double-entry journal. Every UserBalance mutation anywhere in
// the app must write a balanced set of these in the same DB transaction —
// see lib/ledger.ts, which both provides the write helper and the
// reconciliation utility that proves UserBalance is exactly reconstructible
// from this table. accountId is a User.id for a real client, or one of the
// fixed system account labels (SYSTEM_RESERVE, GAS_FEE_COLLECTOR) — it is
// deliberately not a foreign key, since system accounts aren't User rows.
model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  assetId       String
  asset         Asset           @relation(fields: [assetId], references: [id])
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(24, 8)
  createdAt     DateTime        @default(now())

  @@index([accountId, assetId])
  @@index([transactionId])
}

// An on-chain deposit reported by a webhook (see app/api/webhooks/deposit)
// that couldn't be auto-matched to a client-submitted PENDING deposit by
// txHash — sits in this queue for an admin to assign to the correct client
// with one click, at which point a normal approved Transaction row is
// created for them and this row flips to ASSIGNED.
model UnattributedDeposit {
  id             String                    @id @default(cuid())
  assetId        String
  asset          Asset                     @relation(fields: [assetId], references: [id])
  networkName    String
  walletAddress  String
  amount         Decimal                   @db.Decimal(24, 8)
  txHash         String                    @unique
  status         UnattributedDepositStatus @default(PENDING)
  assignedUserId String?
  assignedUser   User?                     @relation(fields: [assignedUserId], references: [id])
  createdAt      DateTime                  @default(now())
}

// Append-only security trail for admin actions that change account state or
// configuration but aren't themselves a Transaction row (status changes,
// asset/address configuration) — Transaction already covers money movement,
// this covers everything else an admin can do.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}
